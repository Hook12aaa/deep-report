{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-report/prose-section-spec.schema.json",
  "title": "deep-report prose section spec",
  "description": "Discriminated union over block types. The prose-spec-author subagent emits one of these per draft section. No free-form markdown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["section_id", "purpose", "audience", "blocks"],
  "properties": {
    "section_id": {"$ref": "#/$defs/id"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 200},
    "audience": {"enum": ["executive", "technical", "general"]},
    "thesis": {"type": "string", "minLength": 1, "maxLength": 240},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/paragraph_block"},
          {"$ref": "#/$defs/why_it_matters_block"},
          {"$ref": "#/$defs/bullets_block"},
          {"$ref": "#/$defs/callout_block"}
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 48},
    "paragraph_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "topic_sentence", "claims", "max_words"],
      "properties": {
        "type": {"const": "paragraph"},
        "topic_sentence": {"type": "string", "minLength": 1, "maxLength": 200},
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "evidence_refs"],
            "properties": {
              "claim": {"type": "string", "minLength": 1, "maxLength": 240},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1, "maxLength": 80}
              }
            }
          }
        },
        "max_words": {"type": "integer", "minimum": 40, "maximum": 180}
      }
    },
    "why_it_matters_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "stake"],
      "properties": {
        "type": {"const": "why_it_matters"},
        "stake": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "bullets_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "bullets"},
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "callout_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "body"],
      "properties": {
        "type": {"const": "callout"},
        "kind": {"enum": ["caveat", "definition", "data_point"]},
        "body": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    }
  }
}
